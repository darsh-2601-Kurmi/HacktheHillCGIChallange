          },
          {
            "name": "Saving a year",
            "displayFolder": "G Scenarios",
            "expression": "CALCULATE ( SUM ( scenarios[handling_saving] ), scenarios[month_index] = 12 ) * 12 / 1000",
            "formatString": "$#,0\"k\"",
            "lineageTag": "f3da2bdd-4919-5dc1-941b-d86661dc9489"
          },
          {
            "name": "Reaches 4.0 (plan)",
            "displayFolder": "G Scenarios",
            "expression": [
              "VAR m = CALCULATE ( MIN ( scenarios[month_index] ), scenarios[score_static] >= 4 )",
              "RETURN IF ( ISBLANK ( m ), \"Not reached\", \"Month \" & m )"
            ],
            "lineageTag": "03fc1ae5-961f-5d85-ab28-97ac0aa3c65a"
          },
          {
            "name": "Reaches 4.0 (backlog-aware)",
            "displayFolder": "G Scenarios",
            "expression": [
              "VAR m = CALCULATE ( MIN ( scenarios[month_index] ), scenarios[score_queue] >= 4 )",
              "RETURN IF ( ISBLANK ( m ), \"Not reached\", \"Month \" & m )"
            ],
            "lineageTag": "53b72c04-75c7-5a88-9076-29c6ee2499f9"
          },
