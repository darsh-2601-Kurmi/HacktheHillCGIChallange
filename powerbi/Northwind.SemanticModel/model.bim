            "formatString": "$#,0\"k\"",
            "lineageTag": "ddde016e-94d4-574b-b076-119c33b9e08a"
          },
          {
            "name": "What-if verdict",
            "displayFolder": "H What-if",
            "expression": [
              "IF ( [Lever rows] <> 1, \"Pick one level on each of the four levers\",",
              "    IF ( [What-if score plan] >= 4, \"4.0 reached, even on the plan method\",",
              "        IF ( [What-if score backlog-aware] >= 4, \"4.0 only if the backlog clears\", \"4.0 not reached\" ) ) )"
            ],
            "lineageTag": "618a9b5a-715d-5dab-9f15-98ea8511293f"
          }
