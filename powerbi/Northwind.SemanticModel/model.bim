      {
        "name": "_Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ],
        "columns": [
          {
            "name": "Column1",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "isHidden": true,
            "lineageTag": "2e3d277e-1144-58ba-b4e6-c74edbac33d0",
            "sourceColumn": "Column1",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "14d1f3b5-52de-525a-ad9a-4970e70d5f30",
        "measures": [
          {
            "name": "Complaints",
            "displayFolder": "A Volume",
            "expression": "COUNTROWS ( complaint_360 )",
            "formatString": "#,0",
            "lineageTag": "cf88266b-2933-52bc-bfa9-037eb3313c47"
          },
          {
            "name": "Open complaints",
            "displayFolder": "A Volume",
            "expression": "CALCULATE ( [Complaints], complaint_360[is_open] = 1 )",
            "formatString": "#,0",
            "lineageTag": "b0d2e7a4-17a4-5763-9d14-a1a465735e10"
          },
          {
            "name": "Transferred",
            "displayFolder": "A Volume",
            "expression": "CALCULATE ( [Complaints], complaint_360[transferred_between_systems] = 1 )",
            "formatString": "#,0",
            "lineageTag": "a2bc10de-89ab-5ed6-820c-74f661cc5c5a"
          },
          {
            "name": "Transfer rate",
            "displayFolder": "A Volume",
            "expression": "DIVIDE ( [Transferred] + 0, [Complaints] )",
            "formatString": "0.0%",
            "lineageTag": "f58e2148-a972-59da-95e9-1d68f2c8230f"
          },
          {
            "name": "Avg days to close",
            "displayFolder": "B Transfers",
            "expression": "AVERAGE ( complaint_360[days_to_close] )",
            "formatString": "0.0",
            "lineageTag": "81b1510b-46cc-5c35-a1f8-08ebd5791eaa"
          },
          {
            "name": "Avg days transferred",
            "displayFolder": "B Transfers",
            "expression": "CALCULATE ( [Avg days to close], complaint_360[transferred_between_systems] = 1 )",
            "formatString": "0.0",
            "lineageTag": "fd47e16e-8992-54e5-94a4-26f5ae4619e4"
          },
          {
            "name": "Avg days not transferred",
            "displayFolder": "B Transfers",
            "expression": "CALCULATE ( [Avg days to close], complaint_360[transferred_between_systems] = 0 )",
            "formatString": "0.0",
            "lineageTag": "43e50aa3-973d-5828-9d4c-45308ea5f826"
          },
          {
            "name": "Days added by a transfer",
            "displayFolder": "B Transfers",
            "expression": "[Avg days transferred] - [Avg days not transferred]",
            "formatString": "0.0",
            "lineageTag": "14a1bdd4-80ad-5ecd-9583-3006330d5dc0"
          },
          {
            "name": "SLA breach rate",
            "displayFolder": "B Transfers",
            "expression": "AVERAGE ( complaint_360[sla_breach] )",
            "formatString": "0.0%",
            "lineageTag": "afefd4b6-1cdd-5b6a-ace6-cad04f679563"
          },
          {
            "name": "Reopen rate",
            "displayFolder": "B Transfers",
            "expression": "AVERAGE ( complaint_360[reopened] )",
            "formatString": "0.0%",
            "lineageTag": "6be19774-37d2-5128-800f-a302d1a7d92a"
          },
          {
            "name": "Avg handling cost",
            "displayFolder": "B Transfers",
            "expression": "AVERAGE ( complaint_360[handling_unit_cost] )",
            "formatString": "$#,0",
            "lineageTag": "34ca9f68-5c0f-5bbb-b120-02b23706e3c1"
          },
          {
            "name": "Handling cost",
            "displayFolder": "B Transfers",
            "expression": "SUM ( complaint_360[handling_unit_cost] ) / 1000",
            "formatString": "$#,0\"k\"",
            "lineageTag": "e83b1a9c-d660-5c2d-adec-8017efc21707"
          },
          {
            "name": "CaseTrack note",
            "displayFolder": "B Transfers",
            "expression": "CALCULATE ( SELECTEDVALUE ( complaint_360[source_system_notes] ), complaint_360[source_system] = \"SYS-04\" )",
            "lineageTag": "80b0bee5-3cfa-50bc-b7c3-b3518538df86"
          },
          {
            "name": "Billing and metering share",
            "displayFolder": "C Complaints",
            "expression": "DIVIDE ( CALCULATE ( [Complaints], complaint_360[category_group] IN { \"Billing\", \"Metering\" } ), [Complaints] )",
            "formatString": "0%",
            "lineageTag": "5b886c73-5e0c-57a4-b075-13675a84fca9"
          },
          {
            "name": "Billing fixed share",
            "displayFolder": "C Complaints",
            "expression": [
              "VAR billing = CALCULATE ( [Complaints], complaint_360[category_group] = \"Billing\" )",
              "VAR fixed = CALCULATE ( [Complaints], complaint_360[category_group] = \"Billing\", complaint_360[resolution_action] IN { \"Bill corrected and re-issued\", \"Refund or credit applied\" } )",
              "RETURN DIVIDE ( fixed, billing )"
            ],
            "formatString": "0%",
            "lineageTag": "9c7a8b59-691a-5e6f-8897-7cab6e66c83f"
          },
          {
            "name": "Info-only complaints",
            "displayFolder": "C Complaints",
            "expression": "CALCULATE ( [Complaints], complaint_360[resolvable_by_information_only] = 1 )",
            "formatString": "#,0",
            "lineageTag": "5beeb1f1-1fcc-5a44-8bea-4540c0e20134"
          },
          {
            "name": "Info-only share",
            "displayFolder": "C Complaints",
            "expression": "DIVIDE ( [Info-only complaints], [Complaints] )",
            "formatString": "0.0%",
            "lineageTag": "e8decb12-1d5a-5024-8284-84a6b492f63e"
          },
          {
            "name": "Avg days info-only",
            "displayFolder": "C Complaints",
            "expression": "CALCULATE ( [Avg days to close], complaint_360[resolvable_by_information_only] = 1 )",
            "formatString": "0.0",
            "lineageTag": "aebe8dfd-cc5b-56ad-9485-64866abf8e68"
          },
          {
            "name": "Transfer rate info-only",
            "displayFolder": "C Complaints",
            "expression": "CALCULATE ( [Transfer rate], complaint_360[resolvable_by_information_only] = 1 )",
            "formatString": "0.0%",
            "lineageTag": "41baa383-381c-5d9e-8c6d-0fe5d4b69f71"
          },
          {
            "name": "Regulator score",
            "displayFolder": "D Score",
            "expression": "AVERAGE ( backlog_month[regulator_satisfaction_score_of_5] )",
            "formatString": "0.00",
            "lineageTag": "43d2e7e2-bd58-5252-80cf-07992b2bac7f"
          },
          {
            "name": "Avg days (KPI)",
            "displayFolder": "D Score",
            "expression": "AVERAGE ( backlog_month[avg_days_to_close] )",
            "formatString": "0.0",
            "lineageTag": "c7714c26-0a0e-5517-9101-c99f491f477e"
          },
          {
            "name": "Open backlog",
            "displayFolder": "D Score",
            "expression": "AVERAGE ( backlog_month[backlog_end] )",
            "formatString": "#,0",
            "lineageTag": "04cf0012-4064-57ac-94cf-9f18a0a963cb"
          },
          {
            "name": "Score today",
            "displayFolder": "D Score",
            "expression": "CALCULATE ( [Regulator score], TOPN ( 1, ALL ( backlog_month[month] ), backlog_month[month], DESC ) )",
            "formatString": "0.00",
            "lineageTag": "4657b04a-9bbe-5456-94e3-7691ead7da2d"
          },
          {
            "name": "Score first month",
            "displayFolder": "D Score",
            "expression": "CALCULATE ( [Regulator score], TOPN ( 1, ALL ( backlog_month[month] ), backlog_month[month], ASC ) )",
            "formatString": "0.00",
            "lineageTag": "f953e677-0641-508d-a05f-e186af60a8ce"
          },
          {
            "name": "Days today",
            "displayFolder": "D Score",
            "expression": "CALCULATE ( [Avg days (KPI)], TOPN ( 1, ALL ( backlog_month[month] ), backlog_month[month], DESC ) )",
            "formatString": "0.0",
            "lineageTag": "1718ff83-5bf9-57d4-a46b-42dc75ad5ec7"
          },
          {
            "name": "Score slope per day",
            "displayFolder": "D Score",
            "expression": [
              "VAR t = ALL ( backlog_month )",
              "VAR mx = AVERAGEX ( t, backlog_month[avg_days_to_close] )",
              "VAR my = AVERAGEX ( t, backlog_month[regulator_satisfaction_score_of_5] )",
              "VAR sxy = SUMX ( t, ( backlog_month[avg_days_to_close] - mx ) * ( backlog_month[regulator_satisfaction_score_of_5] - my ) )",
              "VAR sxx = SUMX ( t, ( backlog_month[avg_days_to_close] - mx ) ^ 2 )",
              "VAR syy = SUMX ( t, ( backlog_month[regulator_satisfaction_score_of_5] - my ) ^ 2 )",
              "RETURN DIVIDE ( sxy, sxx )"
            ],
            "formatString": "0.0000",
            "lineageTag": "9ddd90a7-46de-5de7-819d-41e78e3de92a"
          },
          {
            "name": "Score intercept",
            "displayFolder": "D Score",
            "expression": [
              "VAR t = ALL ( backlog_month )",
              "RETURN AVERAGEX ( t, backlog_month[regulator_satisfaction_score_of_5] ) - [Score slope per day] * AVERAGEX ( t, backlog_month[avg_days_to_close] )"
            ],
            "formatString": "0.000",
            "lineageTag": "29f824fb-654d-532a-a3c8-ab2edca104dc"
          },
          {
            "name": "Score fit r",
            "displayFolder": "D Score",
            "expression": [
              "VAR t = ALL ( backlog_month )",
              "VAR mx = AVERAGEX ( t, backlog_month[avg_days_to_close] )",
              "VAR my = AVERAGEX ( t, backlog_month[regulator_satisfaction_score_of_5] )",
              "VAR sxy = SUMX ( t, ( backlog_month[avg_days_to_close] - mx ) * ( backlog_month[regulator_satisfaction_score_of_5] - my ) )",
              "VAR sxx = SUMX ( t, ( backlog_month[avg_days_to_close] - mx ) ^ 2 )",
              "VAR syy = SUMX ( t, ( backlog_month[regulator_satisfaction_score_of_5] - my ) ^ 2 )",
              "RETURN DIVIDE ( sxy, SQRT ( sxx * syy ) )"
            ],
            "formatString": "0.00",
            "lineageTag": "703af576-f67d-5680-9246-bf1913e506a8"
          },
          {
            "name": "Days needed for 4.0",
            "displayFolder": "D Score",
            "expression": "DIVIDE ( 4 - [Score intercept], [Score slope per day] )",
            "formatString": "0.0",
            "lineageTag": "670699ae-dbb1-5343-9846-c5e20417f323"
          },
          {
            "name": "Target 4.0",
            "displayFolder": "D Score",
            "expression": "IF ( NOT ISBLANK ( [Regulator score] ), 4 )",
            "formatString": "0.0",
            "lineageTag": "fb909005-abed-5b35-8088-937306a5b2e2"
          },
          {
            "name": "Needed for 4.0",
            "displayFolder": "D Score",
            "expression": "IF ( NOT ISBLANK ( [Avg days (KPI)] ), [Days needed for 4.0] )",
