{
  "name": "Northwind light",
  "dataColors": [
    "#2A78D6",
    "#E0612B",
    "#138A61",
    "#EDA100",
    "#D0508C",
    "#6B5BD6",
    "#7D8790",
    "#0F6283"
  ],
  "background": "#FFFFFF",
  "foreground": "#0D1B26",
