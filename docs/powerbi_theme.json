  "background": "#FFFFFF",
  "foreground": "#0D1B26",
  "tableAccent": "#1543C4",
  "good": "#0B7A3F",
  "bad": "#C2302A",
  "neutral": "#6F7C87",
  "textClasses": {
    "title": { "fontFace": "Bahnschrift", "fontSize": 16, "color": "#0D1B26" },
    "header": { "fontFace": "Bahnschrift", "fontSize": 14, "color": "#0D1B26" },
    "callout": { "fontFace": "Bahnschrift", "fontSize": 32, "color": "#0D1B26" },
    "label": { "fontFace": "Segoe UI", "fontSize": 12, "color": "#3F4D59" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
